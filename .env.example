# OPTIONAL: copy this file to .env on your own computer; NEVER commit or upload .env
# Scored CLI: auto (default) enables selective OpenAI only when a key is supplied;
# 0 forces fully offline mode; 1 requires a key too.
# The interactive Studio's remote LLM remains separately opt-in.
TRACEMIND_USE_LLM=auto
OPENAI_API_KEY=
TRACEMIND_MODEL=gpt-4.1-mini
# Model calls during ingest are batched by company/client, max five messages per call.
TRACEMIND_MAX_INGEST_CALLS=12
# Optional local MiniLM semantic evidence retrieval (requires sentence-transformers).
TRACEMIND_SEMANTIC=0
TRACEMIND_SEMANTIC_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Optional override for accurate cost estimates for other model names (USD / million tokens).
# gpt-4.1-mini and gpt-4o-mini have built-in reference rates, override if rates change.
TRACEMIND_PRICE_INPUT_PER_M=
TRACEMIND_PRICE_OUTPUT_PER_M=
# Studio's separate interactive agent also requires explicit consent/remote enablement.
TRACEMIND_STUDIO_ALLOW_REMOTE_LLM=0

# Optional local Qdrant vector database; requires vector-requirements.txt.
# Studio offers a separate 'Vector DB' mode without enabling this CLI flag.
TRACEMIND_VECTOR_DB=0
# Keep Studio and graded CLI indexes separate if both run concurrently.
# TRACEMIND_QDRANT_PATH=C:/your/path/.tracemind-qdrant
